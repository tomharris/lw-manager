bin/
# Stray binaries from ad-hoc `go build ./cmd/...` (the Makefile builds to bin/).
/agent
/control
*.env
.env
.env.local

# Local filesystem blob store
data/

# Isolated worktrees and subagent scratch (see docs/superpowers/).
.claude/worktrees/
.superpowers/

# Captured fixtures are large; track deliberately, not by accident. This
# already covers the corpus tool's frames (fixtures/corpus/<label>/<hash>.png):
# they live in the blob store, not git. fixtures/corpus/index.yaml is a
# .yaml file, so it falls outside this rule and stays committable, same as
# the manifest.yaml exception below.
fixtures/**/*.png
!fixtures/**/manifest.yaml
